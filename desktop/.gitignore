# Local env files
.env
.env.*.local

# tsc transpiles src/**/*.ts and emits the generated JS into app
app/

# out is a symlink to the photos web app's out dir, which contains the built up
# photos app.
out

# electron-builder
dist/

# We download it on demand, if needed for the particular OS/arch.
build/vips*

# Downloaded by scripts/ml-native.js for the particular OS/arch.
build/onnxruntime/

# Rust ML addons staged for packaging by scripts/ml-native.js.
build/ml-native/

# The Rust ML addon and its generated bindings, built by `cargo codegen napi`.
rust-bindings/
